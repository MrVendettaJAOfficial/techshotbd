# Copy this file to .env.local and fill in values from YOUR OWN Supabase
# project. Never commit .env.local, and never put real keys in this file.
# The public anon key is safe to expose only because Row Level Security is
# default-deny — it grants no data by itself.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never import this in browser code, never return it in an
# API response, never log it.
SUPABASE_SERVICE_ROLE_KEY=
# Test payment adapter only. The test adapter signs its simulated callbacks
# with this value; it is NOT a real gateway secret.
TEST_PAYMENT_SIGNING_SECRET=
# Site URL used for auth callbacks and payment redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
