# Copy this file to .env.local and fill in values from YOUR OWN Supabase
# project. Never commit .env.local, and never put real keys in this file.
# The public anon key is safe to expose only because Row Level Security is
# default-deny — it grants no data by itself.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never import this in browser code, never return it in an
# API response, never log it.
SUPABASE_SERVICE_ROLE_KEY=
# Test payment adapter only. The test adapter signs its simulated callbacks
# with this value; it is NOT a real gateway secret. Any random string works.
# If you leave it empty, checkout still works: the in-browser test payment
# page (/checkout/test-pay) accepts the chosen outcome directly (see the
# README, "What happens when TEST_PAYMENT_SIGNING_SECRET is not set").
# The public callback route (POST /api/payments/callback) does NOT have
# that fallback — without a secret it rejects every callback with 400,
# by design. Set a value here before exercising that route.
TEST_PAYMENT_SIGNING_SECRET=
# Site URL used for auth callbacks and payment redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
